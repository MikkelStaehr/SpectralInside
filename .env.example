# Kopiér til .env.local og udfyld. .env.local er i .gitignore.

# --- Supabase ---------------------------------------------------------------

SUPABASE_URL=https://<projekt-ref>.supabase.co

# Den publicerbare nøgle er beregnet til at være offentlig og er beskyttet af
# RLS. Den kan bruges i browseren.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Den hemmelige nøgle går uden om RLS og må KUN bruges serverside. Kommer den
# i frontenden, kan enhver besøgende læse og skrive alt i databasen.
# Hentes under Project Settings -> API keys.
SUPABASE_SECRET_KEY=sb_secret_...

# Forbindelsen til databasen. Den her er den, backenden faktisk bruger, og den
# er IKKE en af nøglerne ovenfor: nøglerne er HTTP-legitimation til REST-API'et,
# det her er et Postgres-login.
#
# Hentes under Connect -> Transaction pooler. Regionen i værtsnavnet varierer
# fra projekt til projekt, så kopiér hele strengen frem for at skrive den af.
# Alle aws-*.pooler.supabase.com svarer på DNS, så en forkert region giver
# "ENOTFOUND tenant/user" i stedet for en tydelig DNS-fejl.
#
# Kender du ikke password'et, laves et nyt under Settings -> Database.
SUPABASE_DB_URL=postgresql://postgres.<projekt-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- VideometerLab ----------------------------------------------------------
# Stier på værten, som monteres skrivebeskyttet ind i containeren.
# På instrument-PC'en hedder Windows-brugeren typisk "Videometer".
#
# Windows:  C:/Users/Videometer/Documents/Videometer/VideometerLab/Blobs/BlobCollections
# Netværk:  //instrument-pc/VideometerLab/Blobs/BlobCollections

UBS_HOST_BLOBDB_DIR=
UBS_HOST_CLASSIFIERS_DIR=

# --- Applikationen ----------------------------------------------------------

UBS_PORT=8000

# --- Connectoren ------------------------------------------------------------
# Sættes KUN på den maskine, hvor VideometerLabs blob-samlinger ligger. Den
# læser dem skrivebeskyttet og skubber dem til Supabase, så den anden maskine
# kan se de samme scanninger.
#
# Flaget er eksplicit med vilje. Peger UBS_BLOBDB_DIR ved et uheld på en
# forkert mappe, skal det ikke føre til, at der bliver lagt noget op.

UBS_SYNC=
UBS_SYNC_INTERVAL=300

# Loft over hvor mange frø pr. scanning der får hele båndrækken med. Kun
# fokusklassen får bånd overhovedet; resten nøjes med en miniature.
UBS_SYNC_BAND_LIMIT=200

# Skemaversioner af .blobdb, som læseren er afprøvet mod. Udvid først når
# skemaet er gennemgået efter en opdatering af VideometerLab.
UBS_BLOBDB_VERSIONS=7

# Hvor mange dage før forfald en vedligeholdelsesopgave melder sig, når
# opgaven ikke selv sætter warn_days.
UBS_DUE_SOON_DAYS=1

# --- Operatørvisningen ------------------------------------------------------
# Den klasse, skærmen i produktionen handler om. Målet er skadede frø, men den
# model findes ikke endnu, så indtil videre peges der på en klasse fra
# purity-modellen, så kæden kan afprøves.

UBS_FOCUS_CLASS=Foreign
UBS_FOCUS_LABEL=Fremmede frø
